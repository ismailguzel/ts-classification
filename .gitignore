# macOS
.DS_Store
.AppleDouble
.LSOverride

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

# Virtual environments
.env
.venv
env/
venv/
ENV/

# Jupyter
.ipynb_checkpoints/

# Logs — run artifacts, produced on the compute host, never committed
logs/

# CatBoost info
catboost_info/

# Coverage / test
.coverage
coverage/
.pytest_cache/
htmlcov/

# Build artifacts
build/
dist/
*.egg-info/
.eggs/

# Cache
.cache/
.mypy_cache/

# IDEs/editors
.vscode/
.idea/
*.swp
*.swo

# Data — raw series and extracted features live on the compute host only.
# Results (metrics JSON, importance CSV, figures) ARE committed: they are the
# paper's evidence and must be versioned alongside the text.
data/
!data/README.md
!data/**/README.md

# Model outputs
outputs/
artifacts/
*.pkl
*.joblib
*.h5
*.pt

# Checkpoints
checkpoints/
*.ckpt


# LaTeX build artifacts — regenerated by `make` in reports/tda-background/
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.toc
*.synctex.gz
