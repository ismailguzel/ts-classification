{
  "_comment": "STUDY A — shape. Nine non-periodic classes. No class contains a seasonal component, so periodicity carries zero label information and cannot leak. contextual_anomaly is deliberately absent: betise 0.4.0 requires a seasonal base for it, which would make it the only periodic class here. It lives in Study B (season-anomaly-config.json) instead. sub_H0 / sup_H0 (sub- and superlevel filtration) are the load-bearing features; H1 is expected to contribute little, and that is the point — Study A is the negative control for H1.",
  "output_root": "../data/raw/shape",
  "output_name": "shape.parquet",
  "fixed_length": 1000,
  "random_seed": 42,
  "classes": {

    "stationary": [
      {"base_series": "ar",          "n": 25, "features": {}},
      {"base_series": "ma",          "n": 25, "features": {}},
      {"base_series": "arma",        "n": 25, "features": {}},
      {"base_series": "white_noise", "n": 25, "features": {}}
    ],

    "deterministic_trend": [
      {"base_series": "ar", "n": 25, "features": {"linear_trend":      {"enabled": true, "direction": "upward"}}},
      {"base_series": "ar", "n": 25, "features": {"quadratic_trend":   {"enabled": true, "direction": "upward"}}},
      {"base_series": "ar", "n": 25, "features": {"cubic_trend":       {"enabled": true, "direction": "upward"}}},
      {"base_series": "ar", "n": 25, "features": {"exponential_trend": {"enabled": true, "direction": "upward"}}}
    ],

    "stochastic_trend": [
      {"base_series": "random_walk",       "n": 25, "features": {}},
      {"base_series": "random_walk_drift", "n": 25, "features": {}},
      {"base_series": "ari",               "n": 25, "features": {}},
      {"base_series": "arima",             "n": 25, "features": {}}
    ],

    "volatility": [
      {"base_series": "arch",   "n": 25, "features": {}},
      {"base_series": "garch",  "n": 25, "features": {}},
      {"base_series": "egarch", "n": 25, "features": {}},
      {"base_series": "aparch", "n": 25, "features": {}}
    ],

    "collective_anomaly": [
      {"base_series": "ar",          "n": 34, "features": {"collective_anomaly": {"enabled": true, "mode": "single", "location": "random"}}},
      {"base_series": "arma",        "n": 33, "features": {"collective_anomaly": {"enabled": true, "mode": "single", "location": "random"}}},
      {"base_series": "white_noise", "n": 33, "features": {"collective_anomaly": {"enabled": true, "mode": "single", "location": "random"}}}
    ],

    "point_anomaly": [
      {"base_series": "ar",          "n": 34, "features": {"point_anomaly": {"enabled": true, "mode": "single", "location": "random", "scale_factor": 5}}},
      {"base_series": "arma",        "n": 33, "features": {"point_anomaly": {"enabled": true, "mode": "single", "location": "random", "scale_factor": 5}}},
      {"base_series": "white_noise", "n": 33, "features": {"point_anomaly": {"enabled": true, "mode": "single", "location": "random", "scale_factor": 5}}}
    ],

    "mean_shift": [
      {"base_series": "ar",   "n": 34, "features": {"mean_shift": {"enabled": true, "mode": "single", "direction": "up"}}},
      {"base_series": "ar",   "n": 33, "features": {"mean_shift": {"enabled": true, "mode": "single", "direction": "down"}}},
      {"base_series": "arma", "n": 33, "features": {"mean_shift": {"enabled": true, "mode": "single", "direction": "up"}}}
    ],

    "variance_shift": [
      {"base_series": "ar",   "n": 34, "features": {"variance_shift": {"enabled": true, "mode": "single", "direction": "up"}}},
      {"base_series": "ar",   "n": 33, "features": {"variance_shift": {"enabled": true, "mode": "single", "direction": "down"}}},
      {"base_series": "arma", "n": 33, "features": {"variance_shift": {"enabled": true, "mode": "single", "direction": "up"}}}
    ],

    "trend_shift": [
      {"base_series": "ar", "n": 50, "features": {"trend_shift": {"enabled": true, "mode": "single", "change_type": "direction_change"}}},
      {"base_series": "ar", "n": 50, "features": {"linear_trend": {"enabled": true, "direction": "upward"}, "trend_shift": {"enabled": true, "mode": "single", "change_type": "direction_change"}}}
    ]

  }
}
