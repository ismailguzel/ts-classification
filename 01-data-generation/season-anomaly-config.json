{
  "_comment": "STUDY B2 — perturbation of the loop. Every class draws 25 series from each of the four seasonal bases, so base identity AND seasonality are held constant across labels: the only thing that varies is the overlay. This is the fair test contextual_anomaly never got. In the pre-0.4.0 data it was generated on a non-seasonal AR base, where betise injected a full-length sine of amplitude 1.5-3x sigma; that sine, not the anomaly, was what the classifier detected (a two-condition FFT rule reproduced F1=1.000 on the old topo-test data). Here the sine is present in every class and therefore carries no information. Geometric expectation in the delay embedding: 'pure' closes a clean loop; point_anomaly adds one far-off vertex; collective_anomaly detaches an arc; contextual_anomaly inverts a segment of the loop while keeping its scale. As in B1, per-series z-normalisation is mandatory.",
  "output_root": "../data/raw/season-anomaly",
  "output_name": "season-anomaly.parquet",
  "fixed_length": 1000,
  "random_seed": 42,
  "classes": {

    "pure": [
      {"base_series": "single_seasonality",   "n": 25, "features": {}},
      {"base_series": "multiple_seasonality", "n": 25, "features": {}},
      {"base_series": "sarma",                "n": 25, "features": {}},
      {"base_series": "sarima",               "n": 25, "features": {}}
    ],

    "contextual_anomaly": [
      {"base_series": "single_seasonality",   "n": 25, "features": {"contextual_anomaly": {"enabled": true, "mode": "single", "location": "random"}}},
      {"base_series": "multiple_seasonality", "n": 25, "features": {"contextual_anomaly": {"enabled": true, "mode": "single", "location": "random"}}},
      {"base_series": "sarma",                "n": 25, "features": {"contextual_anomaly": {"enabled": true, "mode": "single", "location": "random"}}},
      {"base_series": "sarima",               "n": 25, "features": {"contextual_anomaly": {"enabled": true, "mode": "single", "location": "random"}}}
    ],

    "point_anomaly": [
      {"base_series": "single_seasonality",   "n": 25, "features": {"point_anomaly": {"enabled": true, "mode": "single", "location": "random", "scale_factor": 5}}},
      {"base_series": "multiple_seasonality", "n": 25, "features": {"point_anomaly": {"enabled": true, "mode": "single", "location": "random", "scale_factor": 5}}},
      {"base_series": "sarma",                "n": 25, "features": {"point_anomaly": {"enabled": true, "mode": "single", "location": "random", "scale_factor": 5}}},
      {"base_series": "sarima",               "n": 25, "features": {"point_anomaly": {"enabled": true, "mode": "single", "location": "random", "scale_factor": 5}}}
    ],

    "collective_anomaly": [
      {"base_series": "single_seasonality",   "n": 25, "features": {"collective_anomaly": {"enabled": true, "mode": "single", "location": "random"}}},
      {"base_series": "multiple_seasonality", "n": 25, "features": {"collective_anomaly": {"enabled": true, "mode": "single", "location": "random"}}},
      {"base_series": "sarma",                "n": 25, "features": {"collective_anomaly": {"enabled": true, "mode": "single", "location": "random"}}},
      {"base_series": "sarima",               "n": 25, "features": {"collective_anomaly": {"enabled": true, "mode": "single", "location": "random"}}}
    ]

  }
}
